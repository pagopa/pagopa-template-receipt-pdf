{
  "name": "pagopa-receipt-pdf",
  "version": "1.0.0",
  "description": "Template used to generate pagoPA PDF receipts",
  "main": "index.js",
  "scripts": {
    "generate": "node compileHandlebars && yarn -s validate && node generatePDF",
    "validate": "node validateHTML && node validateBarcodes",
    "validate-html": "node validateHTML",
    "validate-barcodes": "node validateBarcodes"
  },
  "license": "ISC",
  "dependencies": {
    "bwip-js": "^4.3.2",
    "handlebars": "^4.7.8",
    "puppeteer": "^25.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "html-validate": "^11.5.6",
    "prettier": "^2.7.1",
    "stylelint": "^14.12.0",
    "stylelint-prettier": "^2.0.0"
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
