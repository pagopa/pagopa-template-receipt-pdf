<!DOCTYPE html>
<html lang="it" xmlns="http://www.w3.org/1999/xhtml">

<head>
  <title>Ricevuta di pagamento{{#if transaction.rrn}} - ID transazione: {{transaction.rrn}}{{/if}}</title>
  <meta http-equiv="Content-Type" content="text/html" charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="style.css" />
</head>

<body>
  {{!-- Content of a page: the transaction data opens the first page, the
  totals close the last one --}}
  {{#*inline "pageContent"}}
  <div class="content-grid">

    {{!-- Transaction Data: summary about the PSP, payment methods, etc… --}}
    {{#if @first}}
    {{> transactionData @root}}
    {{/if}}

    <section class="transaction-detail">
      {{#each this}}

      {{> singleCartItem}}

      {{/each}}
    </section>

    {{#if @last}}
    {{> transactionTotals @root}}
    {{/if}}

  </div>
  {{/inline}}

  {{!-- Cart items per page: `first` on page 1, up to `next` on middle pages,
  up to `last` on the final page, with the totals --}}
  {{#with (paginate cart.items first=2 next=3 last=2) as |pages|}}
  {{#each pages}}
  <div class="page">
    <div class="page-wrapper">

      {{!-- Header -- real on the first page, repeated running header (hidden
      from reading order) on the others --}}
      {{#if @first}}
      {{> header @root}}
      {{else}}
      {{> header @root isRepeated=true}}
      {{/if}}

      {{!-- MAIN CONTENT -- START --}}
      {{#if @first}}
      <main>
        {{> pageContent}}
      </main>
      {{else}}
      {{!-- Continuation block: the document already exposes one <main> on the
      first page, and only one <main> is allowed, so this repeat is a plain
      <section> instead. It is intentionally unlabelled: it follows <main> in
      reading order, and PDF readers have no landmark navigation --}}
      <section class="main-continuation">
        {{> pageContent}}
      </section>
      {{/if}}
      {{!-- MAIN CONTENT -- END --}}

      {{!-- Footer -- real on the last page (closes the reading order), repeated
      running footer on the others --}}
      {{#if @last}}
      {{> footer @root pageCount=pages.length}}
      {{else}}
      {{> footer @root isRepeated=true pageCount=pages.length}}
      {{/if}}

    </div>
  </div>
  {{/each}}
  {{/with}}

</body>

</html>