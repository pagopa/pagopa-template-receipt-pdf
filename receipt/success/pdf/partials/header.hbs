<header class="page-header" aria-label="Intestazione{{#if isContinuation}} (continua){{/if}}">
  <section class="pagopa-header">
    <img class="logo" alt="pagoPA" src="assets/logo-pagoPa.svg" />
    {{#if isContinuation}}
    {{!-- Continuation pages repeat the title visually, but the document must
    expose a single <h1> or the heading outline skips a level --}}
    <p class="title">Ricevuta di pagamento</p>
    {{else}}
    <h1 class="title">Ricevuta di pagamento</h1>
    {{/if}}
  </section>
  {{#if transaction.processedByPagoPA}}
  {{#if transaction.psp.logo}}
  <dl class="psp-header" role="list">
    <div class="kv-item" role="listitem">
      <dt>Per conto di</dt>
      <dd class="psp-logo">
        <img alt="{{transaction.psp.name}}" src="{{transaction.psp.logo}}" />
      </dd>
    </div>
  </dl>
  {{/if}}
  {{/if}}
</header>